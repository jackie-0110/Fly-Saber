# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
test-results/

# Data and outputs (large; never commit)
data/raw/*
data/processed/*
data/maps/*
!data/**/.gitkeep
!data/maps/demo_allowlist.json
checkpoints/
runs/
wandb/
replays/
*.npz

# Web
frontend/node_modules/
frontend/dist/
frontend/playwright-report/

# Secrets
.env
.env.*
!.env.example

# OS / editors
.DS_Store
.vscode/
.idea/

# SLURM logs
slurm-*.out
logs/

# Demo checkpoints shipped with their exact subgraph (scripts/training/bundle_checkpoint.py)
!bundles/**/*.npz

# Downloaded Impeccable engines and per-machine hook state
.agents/skills/*/scripts/bin/
.github/skills/*/scripts/bin/
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json

# Temporary editor/patch files and incremental build metadata
*.tmp
*.bak
*.orig
*.rej
*.tsbuildinfo
